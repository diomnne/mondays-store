# Copy to .env.local and fill in. All variables are server-only; never prefix them with NEXT_PUBLIC_.

# Supabase project URL only, without /rest/v1 (Project Settings → Data API).
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...). Project Settings → API Keys. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Demo-only admin credentials for the simulated login. Not production-safe.
ADMIN_EMAIL=admin@mondays.example
ADMIN_PASSWORD=mondays-demo
# 32+ random characters used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-32-plus-random-characters
